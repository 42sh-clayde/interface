# Configuration équipe — copiée automatiquement en config.env au premier lancement.
# Ne jamais y mettre de PAT (saisi dans l'interface web uniquement).

# Azure DevOps (affiché en lecture seule dans l'UI)
AZDO_ORG=mon-org
AZDO_PROJECT=mon-projet
AZDO_REPO=mon-repo

# Branche de base pour checkout / pull avant déploiement
DEFAULT_BRANCH=main

# Dossier des redirections Apache dans le repo (chemin relatif)
TARGET_FOLDER=config/apache/redirects

# Chemin ABSOLU vers votre clone local du repo AzDO sur cette machine
# Exemple Linux/macOS : /home/user/projets/mon-repo
REPO_PATH=

# Port HTTP local de l'interface
PORT=3100

# Nom de l'image Podman
IMAGE_NAME=localhost/interface-redirects:latest
